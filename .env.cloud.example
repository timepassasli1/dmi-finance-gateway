# ============================================================
# CLOUD DEPLOYMENT ENV VARS
# Copy relevant vars to Railway / Render / Vercel dashboards
# ============================================================

# --- BACKEND (Railway / Render) ---

# Option A: Single DATABASE_URL (Neon / Railway PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: Individual DB vars (if not using DATABASE_URL)
# DB_HOST=your-neon-host.neon.tech
# DB_PORT=5432
# DB_NAME=gateway
# DB_USER=gateway
# DB_PASSWORD=your-db-password
# DB_SSL_MODE=require

# Redis (Railway Redis / Upstash)
REDIS_URL=redis://default:password@host:6379

# Security — generate strong random values!
JWT_SECRET=generate_64_char_random_string_here
ENCRYPTION_KEY=generate_64_hex_char_string_here_32_bytes

# App
PORT=8080
ENVIRONMENT=production
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong_admin_password_here

# CORS — your Vercel frontend URL
CORS_ORIGINS=https://your-app.vercel.app

# --- FRONTEND (Vercel) ---
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- VERIFICATION AGENT (Railway separate service) ---
GATEWAY_URL=https://your-backend.railway.app
AGENT_API_KEY=your-agent-api-key-from-admin-panel
POLL_INTERVAL=30s
